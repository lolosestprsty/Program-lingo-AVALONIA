<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaApplication1.Views.MessageBoxWindow"
        Width="400" Height="150">
  <StackPanel Margin="12">
    <TextBlock Name="MessageText" Text="{Binding}" Margin="0,0,0,10" />
    <StackPanel Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
      <!-- Buttons will be added dynamically -->
    </StackPanel>
  </StackPanel>
</Window>