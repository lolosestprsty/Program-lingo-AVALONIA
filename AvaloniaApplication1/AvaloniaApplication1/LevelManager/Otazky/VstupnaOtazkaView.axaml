    <UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:otazky="using:AvaloniaApplication1.LevelManager.Otazky"
             x:Class="AvaloniaApplication1.Views.Questions.VstupnaOtazkaView"
             x:DataType="otazky:VstupnaOtazka">
  
  <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="40">
    <!-- Question -->
    <TextBlock Grid.Row="0" Text="{Binding OtazkaText}" FontSize="28" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,30" FontWeight="SemiBold" />
    
    <!-- Answer TextBox -->
    <Border Grid.Row="1" HorizontalAlignment="Center" IsVisible="{Binding ShowCorrectAnswerFlag, Converter={StaticResource InverseBoolConverter}}">
      <StackPanel>
        <TextBox x:Name="AnswerTextBox"
                 Text="{Binding UserInput}"
                 Width="400" 
                 Height="50"
                 FontSize="18"
                 HorizontalAlignment="Center"
                 Margin="0,20,0,20"
                 Watermark="Zadajte odpoveď..." />
        <Button x:Name="SubmitButton"
                Content="Odoslať"
                Width="200"
                Theme="{StaticResource ButtonTheme}"
                FontSize="18"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding OdpovedCommand}"
                CommandParameter="{Binding UserInput}" />
      </StackPanel>
    </Border>

    <!-- Correct answer display when wrong -->
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" IsVisible="{Binding ShowCorrectAnswerFlag}" Margin="0,20,0,20">
      <TextBlock Text="Spravna odpoved:" FontSize="18" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding SpravnaOdpovedNoDiacritics}" FontSize="20" Foreground="#8B0000" FontWeight="SemiBold" HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
  
</UserControl>