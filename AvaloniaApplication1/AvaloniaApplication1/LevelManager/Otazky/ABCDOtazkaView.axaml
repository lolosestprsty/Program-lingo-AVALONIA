<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:otazky="using:AvaloniaApplication1.LevelManager.Otazky"
             xmlns:views="using:AvaloniaApplication1.Views.Questions"
             x:Class="AvaloniaApplication1.Views.Questions.ABCDOtazkaView"
             x:DataType="otazky:ABCDOtazka">

    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="40">
        <!-- Question -->
        <TextBlock Grid.Row="0" Text="{Binding OtazkaText}" FontSize="28" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,30" FontWeight="SemiBold" IsVisible="{Binding ShowCorrectAnswerFlag, Converter={StaticResource InverseBoolConverter}}" />

        <!-- Correct answer label shown when incorrect -->
        <TextBlock Grid.Row="0" Text="{Binding SpravnaMoznostTextNoDiacritics, StringFormat='Spravna odpoved: {0}'}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,30" Foreground="#8B0000" IsVisible="{Binding ShowCorrectAnswerFlag}" />

        <!-- Options arranged 2x2 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="24" RowSpacing="20">
            <ItemsControl ItemsSource="{Binding Moznosti}" Width="760" HorizontalAlignment="Center" IsVisible="{Binding ShowCorrectAnswerFlag, Converter={StaticResource InverseBoolConverter}}">
                <ItemsControl.Resources>
					
                </ItemsControl.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="otazky:ABCDMoznost">
                        <Button Command="{Binding DataContext.OdpovedCommand, RelativeSource={RelativeSource AncestorType=views:ABCDOtazkaView}}"
                                Theme="{StaticResource ButtonTheme}"
                                CommandParameter="{Binding Index}"
                                BorderThickness="0"
                                Padding="20,10"
                                Margin="5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                           <Button.Styles>
							   <Style Selector="Button.toolbar /template/ ContentPresenter">
                                   <Setter Property="CornerRadius" Value="20" />
                                </Style>
                                <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                   <Setter Property="CornerRadius" Value="20" />
                                </Style>
                           </Button.Styles>
                            <!-- no custom template: use flat Border for visuals -->
                            <Border  CornerRadius="45"  HorizontalAlignment="Stretch" >
                                <TextBlock Text="{Binding Text}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Padding="10,5" />
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>

</UserControl>
